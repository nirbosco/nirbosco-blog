---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] mt-20">
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-[var(--color-text-muted)]">
        &copy; {currentYear} ניר בוסקו. כל הזכויות שמורות.
      </p>
      <div class="flex items-center gap-4">
        <a href="/rss.xml" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors" aria-label="RSS Feed">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
