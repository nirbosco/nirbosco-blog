---
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  title: string;
  slug: string;
  date: Date;
  category: string;
  description?: string;
  image?: string;
}

const { title, slug, date, category, description, image } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('he-IL', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="post-card group block">
  <!-- Image -->
  {image ? (
    <div class="aspect-[16/10] overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="aspect-[16/10] bg-gradient-to-br from-[var(--color-accent)]/20 to-[var(--color-accent)]/5 flex items-center justify-center">
      <span class="font-heading text-4xl font-bold text-[var(--color-accent)]/30">nb</span>
    </div>
  )}

  <!-- Content -->
  <div class="p-6">
    <div class="flex items-center gap-3 mb-3">
      <CategoryBadge category={category} />
      <time datetime={date.toISOString()} class="text-xs text-[var(--color-text-muted)]">
        {formattedDate}
      </time>
    </div>

    <h3 class="font-heading text-lg font-semibold leading-snug mb-2 group-hover:text-[var(--color-accent)] transition-colors">
      {title}
    </h3>

    {description && (
      <p class="text-sm text-[var(--color-text-muted)] line-clamp-2 leading-relaxed">
        {description}
      </p>
    )}
  </div>
</a>
