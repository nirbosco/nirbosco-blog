---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | ניר בוסקו">
  <section class="max-w-2xl mx-auto px-6 py-20 md:py-32 text-center">
    <h1 class="font-heading text-6xl md:text-8xl font-bold text-[var(--color-accent)] mb-6">404</h1>
    <p class="text-xl text-[var(--color-text-muted)] mb-8">
      הדף שחיפשת לא נמצא
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[var(--color-accent)] text-white font-medium hover:bg-[var(--color-accent-hover)] transition-colors"
    >
      חזרה לדף הבית
    </a>
  </section>
</BaseLayout>
